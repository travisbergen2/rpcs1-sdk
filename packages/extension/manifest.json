{
  "manifest_version": 3,
  "name": "RPCS-1 Ambiguity Check",
  "version": "0.6.0",
  "description": "Amber-flags phrasing a reader could take more than one way \u2014 click the underline, pick the version you meant, or say it in your own words.",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://rpcs1.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RPCS-1 Ambiguity Check"
  }
}
