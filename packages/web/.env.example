# ─── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products/prices in Stripe, then paste the price IDs here.
# Founding-era pricing (env var NAMES are stable plumbing; the meaning is):
STRIPE_FOUNDING_PRICE_ID=price_...   # Founding supporter YEARLY — $79/year recurring
STRIPE_INDIE_PRICE_ID=price_...      # Founding supporter MONTHLY — $9/month recurring
STRIPE_TEAM_PRICE_ID=price_...       # Team (not shown on site; page says "talk to me")
STRIPE_DIAGNOSTIC_ID=price_...       # Founding pilot — $99 one-time (first five)

# ─── License key signing ────────────────────────────────────────────────────────
# Generate a strong random string: openssl rand -hex 32
LICENSE_JWT_SECRET=change-this-to-a-strong-random-string

# ─── Resend (email) ─────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@rpcs1.dev

# ─── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://rpcs1.dev
# For local dev use: NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate limiting ───────────────────────────────────────────────────────────────
FREE_TIER_HOURLY_LIMIT=10

# ─── Python (optional override) ──────────────────────────────────────────────────
# If Python 3 binary is not 'python3', set this.
# RPCS1_PYTHON=python3

# ─── MCP production controls ─────────────────────────────────────────────────────
# Public endpoint controls. Leave MCP_ALLOWED_ORIGINS blank to reject cross-origin
# browser requests; list only exact trusted origins when browser access is required.
MCP_HOURLY_LIMIT=120
MCP_MAX_BODY_BYTES=65536
MCP_ALLOWED_HOSTS=rpcs1.dev,www.rpcs1.dev
MCP_ALLOWED_ORIGINS=
MCP_OAUTH_JWT_SECRET=change-this-to-a-strong-random-string

# ─── Brand ──────────────────────────────────────────────────────────────────────
# Consumer product brand (what users see). The mechanism brand stays RPCS-1
# and renders as "Powered by RPCS-1" in the footer. Renaming the product is
# this one line — no code change.
# NEXT_PUBLIC_BRAND_NAME="Explicit Formula"
