{
  "serverInfo": {
    "name": "RPCS-1 Agent Tuner & Translation Bridge",
    "version": "0.4.2"
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "tools": [
    {
      "name": "recommend_agent_configuration",
      "description": "Diagnose why a deployed AI agent may fail. Returns suggested runtime parameters, a context strategy, a predicted regime, reasoning, warnings, and a next test. Deterministic, stateless, and read-only. Optionally pass target_model to attach measured per-model receiver posture (evidence-graded).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "task_summary": {
                "type": "string",
                "description": "Description of what the AI agent does"
              },
              "domain": {
                "type": "string",
                "description": "Optional domain"
              },
              "expected_duration_per_call": {
                "type": "string",
                "enum": [
                  "short",
                  "medium",
                  "long"
                ]
              }
            }
          },
          "environment": {
            "type": "object",
            "properties": {
              "entropy": {
                "type": "string",
                "enum": [
                  "stable",
                  "moderate",
                  "dynamic",
                  "chaotic"
                ]
              },
              "predictability": {
                "type": "string",
                "enum": [
                  "highly_predictable",
                  "somewhat_predictable",
                  "unpredictable"
                ]
              },
              "stakes": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "catastrophic"
                ]
              },
              "context_relevance": {
                "type": "string",
                "enum": [
                  "short",
                  "medium",
                  "long"
                ]
              },
              "commitment_style": {
                "type": "string",
                "enum": [
                  "decisive",
                  "balanced",
                  "cautious"
                ]
              }
            }
          },
          "target_platform": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "open_source",
              "generic"
            ]
          },
          "target_model": {
            "type": "string",
            "description": "Optional: the actual model id this agent will run on. When measured (E-LIT per-model receiver table), evidence-graded posture data and translation directives are attached to platform_parameters."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "interpret",
      "description": "Detect ambiguity in user messages. Returns AR level, confidence, candidate interpretations, clarifying questions, and a suggested next step.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The message to interpret"
          },
          "risk": {
            "type": "string",
            "enum": [
              "casual",
              "advice",
              "high-stakes",
              "safety-critical"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "fork",
      "description": "Fork view: deterministic structural ambiguity detectors with character-offset spans, per-reading clarifiers, ask-back question, and forked-answer scaffold. Silent on clean text. Mirror floor only over MCP (no model call).",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "normalize",
      "description": "Clean up fragmented human input with ellipses and run-on thoughts into coherent prose.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Fragmented text to normalize"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "rewrite",
      "description": "Return style-specific rewrite instructions for technical, plain, socially gentle, concise, detailed, or direct communication.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to rewrite"
          },
          "style": {
            "type": "string",
            "enum": [
              "technical",
              "plain",
              "socially_gentle",
              "concise",
              "detailed",
              "direct"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "calibrate_profile",
      "description": "Build a continuous communication-preference profile from five behavioral forced-choice answers. Omit answers to receive the questions. The profile is not a diagnosis or category label, and nothing is stored server-side.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "properties": {
              "TI": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "SG": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "FT": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "UE": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "AR": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              }
            },
            "additionalProperties": false,
            "description": "Chosen option per primitive. Omit entirely to receive the five questions."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "prepare_prompt",
      "description": "Recover likely intent from a raw message before acting. Returns a canonical translation, ambiguity level, and whether to clarify or commit; an optional receiver profile shapes that choice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "The user\u2019s raw message."
          },
          "risk": {
            "type": "string",
            "enum": [
              "casual",
              "advice",
              "high-stakes",
              "safety-critical"
            ],
            "default": "advice",
            "description": "Risk category for the ambiguity threshold."
          },
          "profile": {
            "type": "object",
            "properties": {
              "TI": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Temporal Integration: 0 = bottom line first, 100 = full context first"
              },
              "SG": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Signal Gain: 0 = flat and factual, 100 = warm and expressive"
              },
              "FT": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Filtering Threshold: 100 = explicit and literal, 0 = subtext lands"
              },
              "UE": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Update Elasticity: 100 = pushback welcome, 0 = prefers consistency"
              },
              "AR": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Ambiguity Resolution: 100 = commit to best reading, 0 = clarify first"
              }
            },
            "required": [
              "TI",
              "SG",
              "FT",
              "UE",
              "AR"
            ],
            "additionalProperties": false,
            "description": "ReceiverProfile from calibrate_profile."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "render_reply",
      "description": "Return deterministic rendering instructions for a draft reply and a receiver profile. Apply the returned structure, warmth, explicitness, revision, and ambiguity guidance before answering.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Your draft reply."
          },
          "profile": {
            "type": "object",
            "properties": {
              "TI": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Temporal Integration: 0 = bottom line first, 100 = full context first"
              },
              "SG": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Signal Gain: 0 = flat and factual, 100 = warm and expressive"
              },
              "FT": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Filtering Threshold: 100 = explicit and literal, 0 = subtext lands"
              },
              "UE": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Update Elasticity: 100 = pushback welcome, 0 = prefers consistency"
              },
              "AR": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Ambiguity Resolution: 100 = commit to best reading, 0 = clarify first"
              }
            },
            "required": [
              "TI",
              "SG",
              "FT",
              "UE",
              "AR"
            ],
            "additionalProperties": false,
            "description": "ReceiverProfile from calibrate_profile."
          }
        },
        "required": [
          "text",
          "profile"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "route_intent",
      "title": "Route an ambiguous request: commit, present options, or clarify",
      "description": "Entropy routing over competing interpretations \u2014 the model proposes the candidate readings (3\u20137 hypotheses incl. typo/idiom/domain-sense readings, with likelihoods and an unambiguous paraphrase per reading for user verification), the deterministic router computes the posterior + normalized entropy and returns commit / commit_with_note / present_options / clarify (open-ended when nothing discriminates). Profile-aware thresholds. The commit-vs-clarify authority in the pipeline; the built-in default set is a product-routing starter only. Deterministic, stateless, read-only.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "The user's raw message."
          },
          "hypotheses": {
            "type": "array",
            "minItems": 2,
            "maxItems": 24,
            "description": "Candidate interpretations ({id,label,cues?,prior?}). Omit for the generic six-intent starter set plus a catch-all.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "cues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "prior": {
                  "type": "number"
                },
                "paraphrase": {
                  "type": "string",
                  "description": "The user's message rewritten unambiguously under this reading \u2014 shown to the user for intent verification."
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          },
          "likelihoods": {
            "type": "object",
            "description": "Optional externally computed likelihood per hypothesis id \u2014 replaces the lexical scorer.",
            "additionalProperties": {
              "type": "number"
            }
          },
          "profile": {
            "type": "object",
            "properties": {
              "TI": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Temporal Integration: 0 = bottom line first, 100 = full context first"
              },
              "SG": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Signal Gain: 0 = flat and factual, 100 = warm and expressive"
              },
              "FT": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Filtering Threshold: 100 = explicit and literal, 0 = subtext lands"
              },
              "UE": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Update Elasticity: 100 = pushback welcome, 0 = prefers consistency"
              },
              "AR": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Ambiguity Resolution: 100 = commit to best reading, 0 = clarify first"
              }
            },
            "required": [
              "TI",
              "SG",
              "FT",
              "UE",
              "AR"
            ],
            "additionalProperties": false,
            "description": "ReceiverProfile from calibrate_profile."
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "resources": [],
  "prompts": []
}
